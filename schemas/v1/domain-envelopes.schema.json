          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "purpose": {
          "enum": [
            "diagnosis",
            "evaluation_development",
            "evaluation_sealed",
            "inquiry_audit",
            "operational",
            "release_evidence"
          ],
          "type": "string"
        },
        "retention_policy_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "retention_policy",
                  "type": "string"
                }
              }
            }
          ]
        },
        "schema_version": {
          "const": "domain-v1",
          "type": "string"
        },
        "version": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "created_at_utc",
