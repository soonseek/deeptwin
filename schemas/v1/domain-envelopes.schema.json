{
  "$comment": "Structural envelope contract only. Runtime also checks canonical compact sorted UTF-8 bytes, integer lexical representation, Unicode scalars, 64 KiB strings, 1 MiB total bytes, depth 32 and 10000 total items, reference/body equality, non-self/future parents, hash integrity, same-vault resolution, lineage, trusted provenance and authorization. Feature schemas further constrain domain content. Schema validity never grants root installation, human approval or dispatch authority.",
  "$defs": {
    "BootstrapBody": {
      "$comment": "Runtime requires actor content.id == header id. Only authenticated atomic first store initialization may install the three roots.",
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "content": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 36,
                  "minLength": 36,
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  },
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "kind": {
                  "const": "system",
                  "type": "string"
                },
                "origin": {
                  "const": "host_service",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "kind",
                "origin"
              ],
              "type": "object"
            },
            "kind": {
              "const": "actor",
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "content": {
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "const": "deny-by-default-v1",
                  "type": "string"
                }
              },
              "required": [
                "profile"
              ],
              "type": "object"
            },
            "kind": {
              "const": "access_policy",
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "content": {
              "additionalProperties": false,
              "properties": {
                "cache_max_age_days": {
                  "const": 14,
                  "type": "integer"
                },
                "cache_max_bytes": {
                  "const": 1073741824,
                  "type": "integer"
                },
                "core_mode": {
                  "const": "manual_only",
                  "type": "string"
                },
                "diagnostics_max_age_days": {
                  "const": 30,
                  "type": "integer"
                },
                "diagnostics_max_bytes": {
                  "const": 104857600,
                  "type": "integer"
                }
              },
              "required": [
                "core_mode",
                "cache_max_age_days",
                "cache_max_bytes",
                "diagnostics_max_age_days",
                "diagnostics_max_bytes"
              ],
              "type": "object"
            },
            "kind": {
              "const": "retention_policy",
              "type": "string"
            }
          }
        }
      ],
      "properties": {
        "content": {
          "type": "object"
        },
        "created_at_utc": {
          "$comment": "Runtime also validates the calendar date; format assertion support varies.",
          "format": "date-time",
          "maxLength": 27,
          "minLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "type": "string"
        },
        "genesis_ref": {
          "allOf": [
            {
              "$ref": "#/$defs/EntityRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "vault_genesis",
                  "type": "string"
                }
              }
            }
          ]
        },
        "id": {
          "maxLength": 36,
          "minLength": 36,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "access_policy",
            "actor",
            "retention_policy"
          ],
          "type": "string"
        },
        "schema_version": {
          "const": "domain-bootstrap-v1",
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "created_at_utc",
        "genesis_ref",
        "content"
      ],
      "type": "object"
    },
    "CanonicalObject": {
      "additionalProperties": {
        "$ref": "#/$defs/CanonicalValue"
      },
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/CanonicalString"
      },
      "type": "object"
    },
    "CanonicalString": {
      "$comment": "Runtime additionally limits UTF-8 byte length, not only character count.",
      "maxLength": 65536,
      "pattern": "^[^\\uD800-\\uDFFF]*$",
      "type": "string"
    },
    "CanonicalValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775807,
          "type": "integer"
        },
        {
          "$ref": "#/$defs/CanonicalString"
        },
        {
          "items": {
            "$ref": "#/$defs/CanonicalValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "$ref": "#/$defs/CanonicalObject"
        }
      ]
    },
