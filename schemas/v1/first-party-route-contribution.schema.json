{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeptwin.local/schemas/v1/first-party-route-contribution.schema.json",
  "title": "DeepTwin first-party route contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contribution_id", "factory", "routes"],
  "properties": {
    "schema_version": {
      "const": "deeptwin-first-party-route-contribution-v1"
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "factory": {
      "type": "string",
      "pattern": "^app\\.api\\.[a-z][a-z0-9_.]*:create_router$",
      "maxLength": 256
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "methods", "path", "auth_policy", "required_scope"],
        "properties": {
          "route_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "methods": {
            "type": "array",
            "enum": [
              ["DELETE"],
              ["GET"],
              ["DELETE","GET"],
              ["HEAD"],
              ["DELETE","HEAD"],
              ["GET","HEAD"],
              ["DELETE","GET","HEAD"],
              ["OPTIONS"],
              ["DELETE","OPTIONS"],
              ["GET","OPTIONS"],
              ["DELETE","GET","OPTIONS"],
              ["HEAD","OPTIONS"],
              ["DELETE","HEAD","OPTIONS"],
              ["GET","HEAD","OPTIONS"],
              ["DELETE","GET","HEAD","OPTIONS"],
              ["PATCH"],
              ["DELETE","PATCH"],
              ["GET","PATCH"],
              ["DELETE","GET","PATCH"],
              ["HEAD","PATCH"],
              ["DELETE","HEAD","PATCH"],
              ["GET","HEAD","PATCH"],
              ["DELETE","GET","HEAD","PATCH"],
              ["OPTIONS","PATCH"],
              ["DELETE","OPTIONS","PATCH"],
              ["GET","OPTIONS","PATCH"],
              ["DELETE","GET","OPTIONS","PATCH"],
              ["HEAD","OPTIONS","PATCH"],
              ["DELETE","HEAD","OPTIONS","PATCH"],
              ["GET","HEAD","OPTIONS","PATCH"],
              ["DELETE","GET","HEAD","OPTIONS","PATCH"],
              ["POST"],
              ["DELETE","POST"],
              ["GET","POST"],
              ["DELETE","GET","POST"],
              ["HEAD","POST"],
              ["DELETE","HEAD","POST"],
              ["GET","HEAD","POST"],
              ["DELETE","GET","HEAD","POST"],
              ["OPTIONS","POST"],
              ["DELETE","OPTIONS","POST"],
              ["GET","OPTIONS","POST"],
              ["DELETE","GET","OPTIONS","POST"],
              ["HEAD","OPTIONS","POST"],
              ["DELETE","HEAD","OPTIONS","POST"],
              ["GET","HEAD","OPTIONS","POST"],
              ["DELETE","GET","HEAD","OPTIONS","POST"],
              ["PATCH","POST"],
              ["DELETE","PATCH","POST"],
              ["GET","PATCH","POST"],
              ["DELETE","GET","PATCH","POST"],
              ["HEAD","PATCH","POST"],
              ["DELETE","HEAD","PATCH","POST"],
              ["GET","HEAD","PATCH","POST"],
              ["DELETE","GET","HEAD","PATCH","POST"],
              ["OPTIONS","PATCH","POST"],
              ["DELETE","OPTIONS","PATCH","POST"],
              ["GET","OPTIONS","PATCH","POST"],
              ["DELETE","GET","OPTIONS","PATCH","POST"],
              ["HEAD","OPTIONS","PATCH","POST"],
              ["DELETE","HEAD","OPTIONS","PATCH","POST"],
              ["GET","HEAD","OPTIONS","PATCH","POST"],
              ["DELETE","GET","HEAD","OPTIONS","PATCH","POST"],
              ["PUT"],
              ["DELETE","PUT"],
              ["GET","PUT"],
              ["DELETE","GET","PUT"],
              ["HEAD","PUT"],
              ["DELETE","HEAD","PUT"],
              ["GET","HEAD","PUT"],
              ["DELETE","GET","HEAD","PUT"],
              ["OPTIONS","PUT"],
              ["DELETE","OPTIONS","PUT"],
              ["GET","OPTIONS","PUT"],
              ["DELETE","GET","OPTIONS","PUT"],
              ["HEAD","OPTIONS","PUT"],
              ["DELETE","HEAD","OPTIONS","PUT"],
              ["GET","HEAD","OPTIONS","PUT"],
              ["DELETE","GET","HEAD","OPTIONS","PUT"],
              ["PATCH","PUT"],
              ["DELETE","PATCH","PUT"],
              ["GET","PATCH","PUT"],
              ["DELETE","GET","PATCH","PUT"],
              ["HEAD","PATCH","PUT"],
              ["DELETE","HEAD","PATCH","PUT"],
              ["GET","HEAD","PATCH","PUT"],
              ["DELETE","GET","HEAD","PATCH","PUT"],
              ["OPTIONS","PATCH","PUT"],
              ["DELETE","OPTIONS","PATCH","PUT"],
              ["GET","OPTIONS","PATCH","PUT"],
              ["DELETE","GET","OPTIONS","PATCH","PUT"],
              ["HEAD","OPTIONS","PATCH","PUT"],
              ["DELETE","HEAD","OPTIONS","PATCH","PUT"],
              ["GET","HEAD","OPTIONS","PATCH","PUT"],
              ["DELETE","GET","HEAD","OPTIONS","PATCH","PUT"],
              ["POST","PUT"],
              ["DELETE","POST","PUT"],
              ["GET","POST","PUT"],
              ["DELETE","GET","POST","PUT"],
              ["HEAD","POST","PUT"],
              ["DELETE","HEAD","POST","PUT"],
              ["GET","HEAD","POST","PUT"],
              ["DELETE","GET","HEAD","POST","PUT"],
              ["OPTIONS","POST","PUT"],
              ["DELETE","OPTIONS","POST","PUT"],
              ["GET","OPTIONS","POST","PUT"],
              ["DELETE","GET","OPTIONS","POST","PUT"],
              ["HEAD","OPTIONS","POST","PUT"],
              ["DELETE","HEAD","OPTIONS","POST","PUT"],
              ["GET","HEAD","OPTIONS","POST","PUT"],
              ["DELETE","GET","HEAD","OPTIONS","POST","PUT"],
              ["PATCH","POST","PUT"],
              ["DELETE","PATCH","POST","PUT"],
              ["GET","PATCH","POST","PUT"],
              ["DELETE","GET","PATCH","POST","PUT"],
              ["HEAD","PATCH","POST","PUT"],
              ["DELETE","HEAD","PATCH","POST","PUT"],
              ["GET","HEAD","PATCH","POST","PUT"],
              ["DELETE","GET","HEAD","PATCH","POST","PUT"],
              ["OPTIONS","PATCH","POST","PUT"],
              ["DELETE","OPTIONS","PATCH","POST","PUT"],
              ["GET","OPTIONS","PATCH","POST","PUT"],
              ["DELETE","GET","OPTIONS","PATCH","POST","PUT"],
              ["HEAD","OPTIONS","PATCH","POST","PUT"],
              ["DELETE","HEAD","OPTIONS","PATCH","POST","PUT"],
              ["GET","HEAD","OPTIONS","PATCH","POST","PUT"],
              ["DELETE","GET","HEAD","OPTIONS","PATCH","POST","PUT"]
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/api/v1/(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[A-Za-z0-9_{}.-]+(?:/[A-Za-z0-9_{}.-]+)*$",
            "maxLength": 1024
          },
          "auth_policy": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "required_scope": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          }
        }
      }
    }
  }
}
