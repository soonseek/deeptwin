{
  "$comment": "Structural only; actual owner, source and journal admission remain required.",
  "$id": "urn:deeptwin:schemas:v1:deployment:request-stage-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z)(?![\\s\\S])",
      "type": "string"
    },
    "created_by": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 36,
          "minLength": 1,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
          "type": "string"
        },
        "kind": {
          "const": "actor",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
          "type": "string"
        },
        "version": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "domain": {
      "const": "deeptwin-deployment-request-v1",
      "type": "string"
    },
    "effect_payload": {
      "additionalProperties": false,
      "properties": {
        "expected_installation_head": {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        "expected_next_installation_revision": {
          "const": 1,
          "type": "integer"
        },
        "extension_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?)(?![\\s\\S])",
          "type": "string"
        },
        "manifest_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
          "type": "string"
        },
        "new_service_effect": {
          "additionalProperties": false,
          "properties": {
            "named_volume_mounts": {
              "items": {},
              "maxItems": 0,
              "minItems": 0,
              "type": "array",
              "uniqueItems": false
            },
            "network_policy_ref": {
              "additionalProperties": false,
              "properties": {
                "document_kind": {
                  "enum": [
                    "network_declaration"
                  ],
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
                  "type": "string"
                },
                "size_bytes": {
                  "maximum": 65536,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "document_kind",
                "sha256",
                "size_bytes"
              ],
              "type": "object"
            },
            "resource_profile_ref": {
              "additionalProperties": false,
              "properties": {
                "document_kind": {
                  "enum": [
                    "resource_declaration"
                  ],
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
                  "type": "string"
                },
                "size_bytes": {
                  "maximum": 65536,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "document_kind",
                "sha256",
                "size_bytes"
              ],
              "type": "object"
            },
            "service_identity": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*)(?![\\s\\S])",
              "type": "string"
            },
            "socket_mounts": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "container_path": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "mount_id": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^(?:[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*)(?![\\s\\S])",
                    "type": "string"
                  },
                  "purpose": {
                    "const": "broker_pair",
                    "type": "string"
                  },
                  "read_only": {
                    "const": false,
                    "type": "boolean"
                  },
                  "volume_name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^(?:[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*)(?![\\s\\S])",
                    "type": "string"
                  }
                },
                "required": [
                  "mount_id",
                  "volume_name",
                  "container_path",
                  "read_only",
                  "purpose"
                ],
                "type": "object"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array",
              "uniqueItems": false
            }
          },
          "required": [
            "service_identity",
            "socket_mounts",
            "named_volume_mounts",
            "network_policy_ref",
            "resource_profile_ref"
          ],
          "type": "object"
        },
        "schema_id": {
          "const": "deeptwin.extension-stage-request.v1",
          "type": "string"
        },
        "selected_platform_entry": {
          "additionalProperties": false,
          "properties": {
            "config_digest": {
              "maxLength": 71,
              "minLength": 1,
              "pattern": "^(?:sha256:[0-9a-f]{64})(?![\\s\\S])",
              "type": "string"
            },
            "index_digest": {
              "maxLength": 71,
              "minLength": 1,
              "pattern": "^(?:sha256:[0-9a-f]{64})(?![\\s\\S])",
              "type": "string"
            },
            "manifest_digest": {
              "maxLength": 71,
              "minLength": 1,
              "pattern": "^(?:sha256:[0-9a-f]{64})(?![\\s\\S])",
              "type": "string"
            },
            "ordered_layer_digests": {
              "items": {
                "maxLength": 71,
                "minLength": 1,
                "pattern": "^(?:sha256:[0-9a-f]{64})(?![\\s\\S])",
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array",
              "uniqueItems": false
            },
            "platform": {
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ],
              "type": "string"
            }
          },
          "required": [
            "platform",
            "index_digest",
            "manifest_digest",
            "config_digest",
            "ordered_layer_digests"
          ],
          "type": "object"
        },
        "service_descriptor_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "extension_id",
        "manifest_digest",
        "service_descriptor_digest",
        "selected_platform_entry",
        "new_service_effect",
        "expected_installation_head",
        "expected_next_installation_revision"
      ],
      "type": "object"
    },
    "expires_at": {
      "format": "date-time",
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z)(?![\\s\\S])",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{32})(?![\\s\\S])",
      "type": "string"
    },
    "kind": {
      "const": "extension_stage",
      "type": "string"
    },
    "origin_profile_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "preconditions": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "request_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "request_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "request_nonce": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "schema": {
      "const": "deployment-request-v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "domain",
    "request_id",
    "kind",
    "request_nonce",
    "request_digest",
    "instance_id",
    "origin_profile_digest",
    "effect_payload",
    "preconditions",
    "created_by",
    "created_at",
    "expires_at"
  ],
  "type": "object"
}
