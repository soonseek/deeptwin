{
  "$comment": "Structural only; actual owner, source and journal admission remain required.",
  "$id": "urn:deeptwin:schemas:v1:deployment:request-anchor-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 36,
          "minLength": 36,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "const": "extension_manifest",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "exchange_blob_ref": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "operational",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "maximum": 8192,
          "minimum": 1,
          "type": "integer"
        },
        "vault_id": {
          "maxLength": 36,
          "minLength": 36,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "vault_id",
        "purpose",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "prepare_command_id": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "request_blob_ref": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "operational",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "vault_id": {
          "maxLength": 36,
          "minLength": 36,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "vault_id",
        "purpose",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "request_id": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "reservation_revision": {
      "const": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "deployment-request-anchor-v1",
      "type": "string"
    },
    "slot_id": {
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "topology_blob_ref": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "const": "operational",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        },
        "vault_id": {
          "maxLength": 36,
          "minLength": 36,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "vault_id",
        "purpose",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "topology_id": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "topology_revision": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "request_blob_ref",
    "topology_blob_ref",
    "exchange_blob_ref",
    "candidate_ref",
    "topology_id",
    "topology_revision",
    "slot_id",
    "reservation_revision",
    "prepare_command_id"
  ],
  "type": "object"
}
