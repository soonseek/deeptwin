            "namespace": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "maximum": 9223372036854775807,
                  "minimum": 0,
                  "type": "integer"
                },
                "inode": {
                  "maximum": 9223372036854775807,
                  "minimum": 1,
                  "type": "integer"
                }
