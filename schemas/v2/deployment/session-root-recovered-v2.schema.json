{
  "$comment": "Structural only; request/trust relations, signature authenticity, epoch succession and generation binding remain separately required.",
  "$id": "urn:deeptwin:schemas:v2:deployment:session-root-recovered-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z)(?![\\s\\S])",
      "type": "string"
    },
    "generation_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{32})(?![\\s\\S])",
      "type": "string"
    },
    "key_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "origin_profile_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "parent_generation_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "recovery_epoch": {
      "maximum": 1000000,
      "minimum": 2,
      "type": "integer"
    },
    "recovery_receipt_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "schema_version": {
      "const": "session-root-v2",
      "type": "string"
    },
    "state": {
      "const": "recovered",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "key_id",
    "instance_id",
    "origin_profile_digest",
    "recovery_epoch",
    "created_at",
    "state",
    "parent_generation_id",
    "recovery_receipt_sha256"
  ],
  "type": "object"
}
