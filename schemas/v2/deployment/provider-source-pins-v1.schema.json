{
  "$id": "urn:deeptwin:schemas:v2:deployment:provider-source-pins-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
      "type": "string"
    },
    "context_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "context_size_bytes": {
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
    },
    "geometry_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{32})$",
      "type": "string"
    },
    "origin_profile_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "provider_instance_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "provider_recipe_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "schema_version": {
      "const": "deployment-provider-source-pins-v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "origin_profile_digest",
    "context_id",
    "context_sha256",
    "context_size_bytes",
    "provider_recipe_sha256",
    "provider_instance_sha256",
    "geometry_sha256"
  ],
  "type": "object"
}
