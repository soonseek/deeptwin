        },
        "request_digest": {
          "maxLength": 43,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
          "type": "string"
        },
        "request_id": {
          "maxLength": 36,
          "minLength": 1,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
          "type": "string"
        },
        "revision": {
          "const": 2,
          "type": "integer"
        },
        "source_context_sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
          "type": "string"
        },
        "state": {
          "const": "cancelled",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "request_digest",
        "kind",
        "state",
        "revision",
        "publication_state",
        "cancellation_publication_state",
        "source_context_sha256",
