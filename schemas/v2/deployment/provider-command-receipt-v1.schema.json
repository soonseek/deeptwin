          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "extension_stage",
          "type": "string"
        },
        "links": {
          "additionalProperties": false,
          "properties": {
            "cancel": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^(?:/(?:[0-9a-f]{32}/)?api/v1/deployment/provider-requests/[0-9a-f-]{36}/cancel)(?![\\s\\S])",
              "type": "string"
            },
            "events": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^(?:/(?:[0-9a-f]{32}/)?api/v1/events)(?![\\s\\S])",
              "type": "string"
            },
            "self": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^(?:/(?:[0-9a-f]{32}/)?api/v1/deployment/provider-requests/[0-9a-f-]{36})(?![\\s\\S])",
              "type": "string"
            }
          },
          "required": [
            "self",
