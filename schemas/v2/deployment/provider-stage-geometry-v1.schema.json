{
  "$id": "urn:deeptwin:schemas:v2:deployment:provider-stage-geometry-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "control": {
      "additionalProperties": false,
      "properties": {
        "gid": {
          "const": 20102,
          "type": "integer"
        },
        "service_identity": {
          "const": "control",
          "type": "string"
        },
        "uid": {
          "const": 20102,
          "type": "integer"
        }
      },
      "required": [
        "service_identity",
        "uid",
        "gid"
      ],
      "type": "object"
    },
    "instance_id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{32})$",
      "type": "string"
    },
    "origin_profile": {
      "additionalProperties": false,
      "properties": {
        "base_path": {
          "maxLength": 34,
          "minLength": 1,
          "type": "string"
        },
        "deployment_profile_id": {
          "enum": [
            "local-no-terminal-v1",
            "portable-compose-v1"
          ],
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "type": "string"
        },
        "instance_id": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{32})$",
          "type": "string"
        },
        "mode": {
          "enum": [
            "local_loopback",
            "portable_https"
          ]
        },
        "origin_base": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        }
      },
      "required": [
        "deployment_profile_id",
        "instance_id",
        "mode",
        "scheme",
        "host",
        "port",
        "base_path",
        "origin_base",
        "digest"
      ],
      "type": "object"
    },
    "original_instance": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "original_recipe": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "size_bytes": {
          "const": 606,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "original_topology": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 65536,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "platform": {
      "enum": [
        "linux/amd64",
        "linux/arm64"
      ]
    },
    "schema_version": {
      "const": "provider-stage-geometry-v1",
      "type": "string"
    },
    "slots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maxLength": 42,
            "minLength": 1,
            "pattern": "^(?:cp-ext-[0-9a-f]{32}-[0-9]{2})$",
            "type": "string"
          },
          "gid": {
            "maximum": 22016,
            "minimum": 22001,
            "type": "integer"
          },
          "pair_gid": {
            "maximum": 23016,
            "minimum": 23001,
            "type": "integer"
          },
          "protocol_id": {
            "const": "deeptwin-extension-worker-v1",
            "type": "string"
          },
          "resource_budget": {
            "additionalProperties": false,
            "properties": {
              "cpu_millicores": {
                "const": 1000,
                "type": "integer"
              },
              "memory_bytes": {
                "const": 1073741824,
                "type": "integer"
              },
              "pids_limit": {
                "const": 128,
                "type": "integer"
              },
              "tmpfs_bytes": {
                "const": 134217728,
                "type": "integer"
              }
            },
            "required": [
              "memory_bytes",
              "cpu_millicores",
              "pids_limit",
              "tmpfs_bytes"
            ],
            "type": "object"
          },
          "service_identity": {
            "maxLength": 39,
            "minLength": 1,
            "pattern": "^(?:ext-[0-9a-f]{32}-[0-9]{2})$",
            "type": "string"
          },
          "slot_number": {
            "maximum": 16,
            "minimum": 1,
            "type": "integer"
          },
          "socket_mount": {
            "additionalProperties": false,
            "properties": {
              "container_path": {
                "maxLength": 24,
                "minLength": 1,
                "pattern": "^(?:/run/deeptwin/ipc/xs[0-9]{2})$",
                "type": "string"
              },
              "mount_id": {
                "maxLength": 4,
                "minLength": 1,
                "pattern": "^(?:xs[0-9]{2})$",
                "type": "string"
              },
              "purpose": {
                "const": "broker_pair",
                "type": "string"
              },
              "read_only": {
                "const": false,
                "type": "boolean"
              },
              "volume_name": {
                "maxLength": 44,
                "minLength": 1,
                "pattern": "^(?:dt-[0-9a-f]{32}-ipc-xs[0-9]{2})$",
                "type": "string"
              }
            },
            "required": [
              "mount_id",
              "volume_name",
              "container_path",
              "read_only",
              "purpose"
            ],
            "type": "object"
          },
          "socket_name": {
            "const": "worker.sock",
            "type": "string"
          },
          "uid": {
            "maximum": 22016,
            "minimum": 22001,
            "type": "integer"
          }
        },
        "required": [
          "slot_number",
          "service_identity",
          "uid",
          "gid",
          "channel_id",
          "pair_gid",
          "socket_mount",
          "socket_name",
          "protocol_id",
          "resource_budget"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "topology_id": {
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
      "type": "string"
    },
    "topology_revision": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "original_recipe",
    "original_instance",
    "original_topology",
    "origin_profile",
    "instance_id",
    "topology_id",
    "topology_revision",
    "platform",
    "control",
    "slots"
  ],
  "type": "object"
}
