{
  "$comment": "Structural only; request/trust relations, signature authenticity, epoch succession and generation binding remain separately required.",
  "$id": "urn:deeptwin:schemas:v2:deployment:receipt-recovery-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z)(?![\\s\\S])",
      "type": "string"
    },
    "deployment_profile_id": {
      "enum": [
        "local-no-terminal-v1",
        "portable-compose-v1"
      ],
      "type": "string"
    },
    "domain": {
      "const": "deeptwin-deployment-recovery-receipt-v1",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{32})(?![\\s\\S])",
      "type": "string"
    },
    "key_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "kind": {
      "const": "owner_recovery",
      "type": "string"
    },
    "new_epoch": {
      "maximum": 1000000,
      "minimum": 2,
      "type": "integer"
    },
    "new_generation_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "new_manifest_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "new_verifier_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "operator_adapter": {
      "const": "deeptwin-recovery-operator-v1",
      "type": "string"
    },
    "operator_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "origin_profile_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "previous_epoch": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "previous_generation_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "previous_manifest_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "request_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "request_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "request_nonce": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "schema": {
      "const": "deployment-recovery-receipt-v1",
      "type": "string"
    },
    "signature": {
      "maxLength": 86,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{85}[AQgw])(?![\\s\\S])",
      "type": "string"
    },
    "trust_class": {
      "const": "instance_operator",
      "type": "string"
    },
    "trust_set_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "domain",
    "request_id",
    "request_digest",
    "request_nonce",
    "kind",
    "instance_id",
    "origin_profile_digest",
    "deployment_profile_id",
    "operator_adapter",
    "operator_version",
    "previous_epoch",
    "previous_generation_id",
    "previous_manifest_sha256",
    "new_epoch",
    "new_generation_id",
    "new_manifest_sha256",
    "new_verifier_sha256",
    "completed_at",
    "key_id",
    "trust_set_digest",
    "trust_class",
    "signature"
  ],
  "type": "object"
}
