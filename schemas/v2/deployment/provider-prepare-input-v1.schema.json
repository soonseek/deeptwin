{
  "$comment": "Structural only; pure parsing and joins grant no deployment authority.",
  "$id": "urn:deeptwin:schemas:v2:deployment:provider-prepare-input-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "command_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "expires_in_seconds": {
      "maximum": 86400,
      "minimum": 60,
      "type": "integer"
    },
    "kind": {
      "const": "extension_stage",
      "type": "string"
    },
    "slot_id": {
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "source_context_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "kind",
    "candidate_id",
    "slot_id",
    "expires_in_seconds",
    "source_context_sha256"
  ],
  "type": "object"
}
