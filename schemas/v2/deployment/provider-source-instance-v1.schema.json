{
  "$id": "urn:deeptwin:schemas:v2:deployment:provider-source-instance-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consumption_exchange_id": {
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
      "type": "string"
    },
    "context_id": {
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
      "type": "string"
    },
    "exchange_id": {
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
      "type": "string"
    },
    "geometry_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "ingress_id": {
      "maxLength": 36,
      "minLength": 1,
      "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
      "type": "string"
    },
    "initializer_image": {
      "maxLength": 584,
      "minLength": 1,
      "pattern": "^(?:[a-z0-9.:-]+/[a-z0-9/._-]+@sha256:[0-9a-f]{64})$",
      "type": "string"
    },
    "original_prepare_instance_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "original_receipt_instance_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "provider_recipe_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "provider_trust_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "schema_version": {
      "const": "deployment-provider-source-instance-v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "original_prepare_instance_sha256",
    "original_receipt_instance_sha256",
    "geometry_sha256",
    "provider_recipe_sha256",
    "provider_trust_sha256",
    "context_id",
    "exchange_id",
    "ingress_id",
    "consumption_exchange_id",
    "initializer_image"
  ],
  "type": "object"
}
