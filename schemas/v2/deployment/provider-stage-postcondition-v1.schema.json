{
  "$id": "urn:deeptwin:schemas:v2:deployment:provider-stage-postcondition-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_ms": {
      "maximum": 2000,
      "minimum": 1,
      "type": "integer"
    },
    "comparison": {
      "const": "equal",
      "type": "string"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "build_identity_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
          "type": "string"
        },
        "gid": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "implemented_transforms": {
          "const": [
            "catalog",
            "text"
          ],
          "type": "array"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ],
          "type": "string"
        },
        "port_contract_version": {
          "const": "provider-port-v1",
          "type": "string"
        },
        "port_schema_set_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
          "type": "string"
        },
        "service_identity": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^(?:[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*)(?![\\s\\S])",
          "type": "string"
        },
        "uid": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "worker_profile": {
          "const": "claude-text-transform-v1",
          "type": "string"
        }
      },
      "required": [
        "service_identity",
        "build_identity_digest",
        "port_schema_set_digest",
        "port_contract_version",
        "platform",
        "uid",
        "gid",
        "worker_profile",
        "implemented_transforms"
      ],
      "type": "object"
    },
