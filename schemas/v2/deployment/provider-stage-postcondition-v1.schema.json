      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": false
    },
    "observed_at": {
      "format": "date-time",
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z)(?![\\s\\S])",
      "type": "string"
    },
    "preserved_inventory_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "receipt_blob_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "receipt_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "request_blob_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    },
    "request_digest": {
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048])(?![\\s\\S])",
      "type": "string"
    },
    "request_id": {
      "maxLength": 36,
      "minLength": 1,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
      "type": "string"
    },
    "schema_version": {
      "const": "provider-stage-postcondition-v1",
      "type": "string"
    },
    "source_context_sha256": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "request_digest",
    "receipt_digest",
    "request_blob_sha256",
    "receipt_blob_sha256",
    "source_context_sha256",
    "preserved_inventory_sha256",
    "observed_at",
    "attempt_ms",
    "expected",
    "observations",
    "comparison"
  ],
  "type": "object"
}
