      "items": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
            "type": "string"
          },
          "connection_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
            "type": "string"
          },
          "listener_record_sha256": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
            "type": "string"
          },
          "nonce": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "maxLength": 24,
            "minLength": 1,
            "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z)(?![\\s\\S])",
            "type": "string"
          },
          "ordinal": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "peer_gid": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "peer_uid": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "reply": {
            "additionalProperties": false,
            "properties": {
              "build_identity_digest": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
                "type": "string"
              },
              "challenge": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
                "type": "string"
              },
              "gid": {
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "implemented_transforms": {
                "const": [
                  "catalog",
                  "text"
                ],
                "type": "array"
              },
              "platform": {
                "enum": [
                  "linux/amd64",
                  "linux/arm64"
                ],
                "type": "string"
              },
              "port_schema_set_digest": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
                "type": "string"
              },
              "schema": {
                "const": "provider-worker-identity-v1",
                "type": "string"
              },
              "service_identity": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^(?:[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*)(?![\\s\\S])",
                "type": "string"
              },
              "uid": {
                "maximum": 4294967295,
                "minimum": 1,
                "type": "integer"
              },
              "worker_profile": {
                "const": "claude-text-transform-v1",
                "type": "string"
              }
            },
            "required": [
              "schema",
              "challenge",
              "service_identity",
              "build_identity_digest",
              "port_schema_set_digest",
              "platform",
              "uid",
              "gid",
              "worker_profile",
              "implemented_transforms"
            ],
            "type": "object"
          },
          "reply_message_id": {
            "maxLength": 36,
            "minLength": 1,
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
            "type": "string"
          },
          "request_message_id": {
            "maxLength": 36,
            "minLength": 1,
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            },
            "pattern": "^(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})(?![\\s\\S])",
            "type": "string"
          },
          "requester_boot_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
            "type": "string"
          },
          "responder_boot_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])",
            "type": "string"
          }
        },
        "required": [
          "ordinal",
          "observed_at",
          "connection_id",
          "requester_boot_id",
          "responder_boot_id",
          "listener_record_sha256",
          "peer_uid",
          "peer_gid",
          "nonce",
          "challenge",
          "request_message_id",
          "reply_message_id",
          "reply"
        ],
        "type": "object"
