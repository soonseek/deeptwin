{
  "$id": "urn:deeptwin:schemas:v2:extensions:provider-installation-record-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body": {
      "additionalProperties": false,
      "properties": {
        "access_policy_ref": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 36,
              "minLength": 36,
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "access_policy",
              "type": "string"
            },
            "sha256": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "const": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "sha256"
          ],
          "type": "object"
        },
        "actor_ref": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 36,
              "minLength": 36,
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "actor",
              "type": "string"
            },
            "sha256": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "const": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "sha256"
          ],
          "type": "object"
        },
        "content": {
          "additionalProperties": false,
          "properties": {
            "command_id": {
              "maxLength": 36,
              "minLength": 1,
              "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
              "type": "string"
            },
            "evidence": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "blob_ref": {
                    "additionalProperties": false,
                    "properties": {
                      "purpose": {
                        "const": "operational",
                        "type": "string"
                      },
                      "sha256": {
                        "maxLength": 64,
                        "minLength": 64,
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "size": {
                        "maximum": 8388608,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "vault_id": {
                        "maxLength": 36,
                        "minLength": 36,
                        "not": {
                          "const": "00000000-0000-0000-0000-000000000000"
                        },
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "vault_id",
                      "purpose",
                      "sha256",
                      "size"
                    ],
                    "type": "object"
                  },
                  "role": {
                    "enum": [
                      "release_review",
                      "provenance",
                      "image_sbom",
                      "component_license_review",
                      "image_scan",
                      "component_scan",
                      "source_report",
                      "dependency_report",
                      "filesystem_report",
                      "cohort_manifest",
                      "invocation",
                      "license_text",
                      "origin_evidence"
                    ]
                  }
                },
                "required": [
                  "role",
                  "blob_ref"
                ],
                "type": "object"
              },
              "maxItems": 128,
              "minItems": 12,
              "type": "array"
            },
            "evidence_policy_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "extension_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?)$",
              "type": "string"
            },
            "extension_version": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))$",
              "type": "string"
            },
            "image_index_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "platform": {
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ]
            },
            "previous_record_digest": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "release_context_blob_ref": {
              "additionalProperties": false,
              "properties": {
                "purpose": {
                  "const": "operational",
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "size": {
                  "maximum": 8192,
                  "minimum": 1,
                  "type": "integer"
                },
                "vault_id": {
                  "maxLength": 36,
                  "minLength": 36,
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  },
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                }
              },
              "required": [
                "vault_id",
                "purpose",
                "sha256",
                "size"
              ],
              "type": "object"
            },
            "release_review_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "release_source_context_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "release_trust_blob_ref": {
              "additionalProperties": false,
              "properties": {
                "purpose": {
                  "const": "operational",
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "size": {
                  "maximum": 16384,
                  "minimum": 1,
                  "type": "integer"
                },
                "vault_id": {
                  "maxLength": 36,
                  "minLength": 36,
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  },
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                }
              },
              "required": [
                "vault_id",
                "purpose",
                "sha256",
                "size"
              ],
              "type": "object"
            },
            "revision": {
              "const": 2,
              "type": "integer"
            },
            "schema_version": {
              "const": "provider-installation-verified-v1",
              "type": "string"
            },
            "selected_manifest_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "service_descriptor_sha256": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^(?:[0-9a-f]{64})$",
              "type": "string"
            },
            "stage_ref": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 36,
                  "minLength": 36,
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  },
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "kind": {
                  "const": "extension_installation",
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "id",
                "version",
                "sha256"
              ],
              "type": "object"
            },
            "state": {
              "const": "verified",
              "type": "string"
            },
            "verified_at_ms": {
              "maximum": 253402300799999,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "schema_version",
            "state",
            "revision",
            "stage_ref",
            "previous_record_digest",
            "extension_id",
            "extension_version",
            "platform",
            "image_index_sha256",
            "selected_manifest_sha256",
            "service_descriptor_sha256",
            "command_id",
            "verified_at_ms",
            "release_context_blob_ref",
            "release_trust_blob_ref",
            "release_source_context_sha256",
            "release_review_sha256",
            "evidence_policy_sha256",
            "evidence"
          ],
          "type": "object"
        },
        "created_at_utc": {
          "$comment": "Runtime also validates the calendar date; format assertion support varies.",
          "format": "date-time",
          "maxLength": 27,
          "minLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
          "type": "string"
        },
        "id": {
          "maxLength": 36,
          "minLength": 1,
          "pattern": "^(?:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
          "type": "string"
        },
        "kind": {
          "const": "extension_installation",
          "type": "string"
        },
        "parent_refs": {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 36,
                  "minLength": 36,
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  },
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "kind": {
                  "const": "extension_installation",
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "version": {
                  "const": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "id",
                "version",
                "sha256"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        },
        "purpose": {
          "const": "operational",
          "type": "string"
        },
        "retention_policy_ref": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 36,
              "minLength": 36,
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "kind": {
              "const": "retention_policy",
              "type": "string"
            },
            "sha256": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "version": {
              "const": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "id",
            "version",
            "sha256"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": "domain-v1",
          "type": "string"
        },
        "version": {
          "const": 2,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "created_at_utc",
        "actor_ref",
        "parent_refs",
        "purpose",
        "access_policy_ref",
        "retention_policy_ref",
        "content"
      ],
      "type": "object"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 36,
          "minLength": 36,
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "kind": {
          "const": "extension_installation",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": 2,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    }
