{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "deeptwin:q01-release-v5:pre-dispatch-manifest",
 "title": "Pre-dispatch manifest (schema v3) frozen before the first dispatch",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "design_id",
  "critic_configuration",
  "critic_configuration_digest",
  "run_identity",
  "attempt",
  "prior_attempts",
  "attestations",
  "lens_effect"
 ],
 "properties": {
  "schema": {
   "const": "q01-pre-dispatch-manifest-3"
  },
  "design_id": {
   "const": "q01-release-v5"
  },
  "critic_configuration": {
   "$ref": "#/$defs/critic_configuration"
  },
  "critic_configuration_digest": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "run_identity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sealed_dataset_sha256",
    "sealed_expectations_sha256",
    "judge_identity",
    "judge_prompt_digest",
    "independence_profile",
    "harness",
    "verifier",
    "case_order",
    "authority_ref",
    "usd_hard_stop",
    "planned_slots",
    "dispatch_journal"
   ],
   "properties": {
    "sealed_dataset_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "sealed_expectations_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "judge_identity": {
     "type": "string",
     "minLength": 1
    },
    "judge_prompt_digest": {
     "oneOf": [
      {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "independence_profile": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "path",
      "sha256"
     ],
     "properties": {
      "path": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     }
    },
    "harness": {
     "$ref": "#/$defs/code_identity"
    },
    "verifier": {
     "$ref": "#/$defs/code_identity"
    },
    "case_order": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "seed",
      "order"
     ],
     "properties": {
      "seed": {
       "type": "string"
      },
      "order": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      }
     }
    },
    "authority_ref": {
     "type": "string",
     "minLength": 1
    },
    "usd_hard_stop": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "planned_slots": {
     "$comment": "case_order x 3 repetitions, case-major and in order: [(order[0],1),(order[0],2),(order[0],3),(order[1],1),...]; the dispatch journal must follow it",
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "case_id",
       "repetition"
      ],
      "properties": {
       "case_id": {
        "type": "string",
        "minLength": 1
       },
       "repetition": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
       }
      }
     }
    },
    "dispatch_journal": {
     "$comment": "the append-only, hash-chained dispatch journal of this manifest (one journal per manifest)",
     "type": "object",
     "additionalProperties": false,
     "required": [
      "path"
     ],
     "properties": {
      "path": {
       "type": "string",
       "pattern": "^/",
       "minLength": 2
      }
     }
    }
   }
  },
  "attempt": {
   "type": "integer",
   "minimum": 1
  },
  "prior_attempts": {
   "$ref": "#/$defs/prior_attempts"
  },
  "attestations": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "author",
    "reviewer",
    "sealing"
   ],
   "properties": {
    "author": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "statement",
      "attested_on"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "attested_on": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
     }
    },
    "reviewer": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "statement",
      "attested_on"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "attested_on": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
     }
    },
    "sealing": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "statement",
      "attested_on"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "statement": {
       "type": "string",
       "minLength": 1
      },
      "attested_on": {
       "type": "string",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
     }
    }
   }
  },
  "lens_effect": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "design_id",
      "effect_set_sha256",
      "qualification_sets",
      "arms",
      "arm_case_order",
      "predictions_sha256"
     ],
     "properties": {
      "design_id": {
       "const": "lens-effects-v5"
      },
      "effect_set_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "qualification_sets": {
       "$comment": "every qualification set the arms' configurations were qualified on; the effect set must be none of them",
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "design_id",
         "sealed_dataset_sha256",
         "sealed_expectations_sha256"
        ],
        "properties": {
         "design_id": {
          "type": "string",
          "minLength": 1
         },
         "sealed_dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         },
         "sealed_expectations_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         }
        }
       }
      },
      "arms": {
       "type": "array",
       "minItems": 2,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id",
         "critic_configuration",
         "critic_configuration_digest",
         "text_sha256",
         "attempt",
         "prior_attempts"
        ],
        "properties": {
         "id": {
          "enum": [
           "no_lens",
           "general_multi_perspective",
           "single_L-P050-01",
           "single_L-P033-02",
           "mix"
          ]
         },
         "critic_configuration": {
          "$ref": "#/$defs/critic_configuration"
         },
         "critic_configuration_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         },
         "text_sha256": {
          "oneOf": [
           {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           {
            "type": "null"
           }
          ]
         },
         "attempt": {
          "type": "integer",
          "minimum": 1
         },
         "prior_attempts": {
          "$ref": "#/$defs/prior_attempts"
         }
        }
       }
      },
      "arm_case_order": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "arm",
         "case_id"
        ],
        "properties": {
         "arm": {
          "type": "string"
         },
         "case_id": {
          "type": "string"
         }
        }
       }
      },
      "predictions_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     }
    }
   ]
  }
 },
 "$defs": {
  "critic_configuration": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "provider",
    "mode",
    "model",
    "effort",
    "max_tokens",
    "critic_prompt_digest",
    "contract_version",
    "parser_version",
    "max_proposed_chains",
    "call_and_run_deadlines",
    "lens_refs_and_digests"
   ],
   "properties": {
    "provider": {
     "type": "string"
    },
    "mode": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "effort": {
     "type": [
      "string",
      "null"
     ]
    },
    "max_tokens": {
     "type": "integer",
     "minimum": 1
    },
    "critic_prompt_digest": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "contract_version": {
     "type": "string"
    },
    "parser_version": {
     "type": "string"
    },
    "max_proposed_chains": {
     "type": "integer",
     "minimum": 0
    },
    "call_and_run_deadlines": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "call_seconds",
      "run_seconds"
     ],
     "properties": {
      "call_seconds": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "run_seconds": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     }
    },
    "lens_refs_and_digests": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "pack_id",
      "pack_version",
      "pack_sha256",
      "rules"
     ],
     "properties": {
      "pack_id": {
       "type": "string",
       "minLength": 1
      },
      "pack_version": {
       "type": "string",
       "minLength": 1
      },
      "pack_sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "rules": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "lens_id",
         "version",
         "sha256"
        ],
        "properties": {
         "lens_id": {
          "type": "string",
          "minLength": 1
         },
         "version": {
          "type": "string",
          "minLength": 1
         },
         "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         }
        }
       }
      }
     }
    }
   }
  },
  "prior_attempts": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "attempt",
     "design_id",
     "sealed_dataset_sha256",
     "sealed_expectations_sha256",
     "suite_outcome"
    ],
    "properties": {
     "attempt": {
      "type": "integer",
      "minimum": 1
     },
     "design_id": {
      "type": "string"
     },
     "sealed_dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "sealed_expectations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "suite_outcome": {
      "enum": [
       "pass",
       "fail",
       "incomplete",
       "not_judged"
      ]
     }
    }
   }
  },
  "code_identity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "sha256"
   ],
   "properties": {
    "version": {
     "type": "string",
     "minLength": 1
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  }
 }
}
