{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "deeptwin:q01-release-v5:suite-record",
 "title": "Suite verdict record of one release-v5 attempt",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "design_id",
  "critic_configuration_digest",
  "pre_dispatch_manifest_sha256",
  "sealed_set_sha256",
  "attempt",
  "prior_outcomes",
  "suite_outcome",
  "independence_profile_sha256",
  "judge_separation_established",
  "v3_error_independence",
  "prior_sealed_set_sha256s",
  "prior_attempts_sha256",
  "dispatch_journal_head",
  "manifest_commit_ref",
  "record_sha256"
 ],
 "properties": {
  "schema_version": {
   "const": "q01-release-suite-verdict-v4"
  },
  "design_id": {
   "const": "q01-release-v5"
  },
  "critic_configuration_digest": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "pre_dispatch_manifest_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "sealed_set_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "attempt": {
   "type": "integer",
   "minimum": 1
  },
  "prior_outcomes": {
   "type": "array",
   "items": {
    "enum": [
     "pass",
     "fail",
     "incomplete",
     "not_judged"
    ]
   }
  },
  "suite_outcome": {
   "enum": [
    "pass",
    "fail",
    "incomplete",
    "not_judged"
   ]
  },
  "independence_profile_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "judge_separation_established": {
   "type": "boolean"
  },
  "v3_error_independence": {
   "const": "unverified",
   "$comment": "release-v5 has no generation path and cannot verify V3; the verifier derives this value, never the caller, and the product gate refuses a release-v5 record with any other value"
  },
  "prior_sealed_set_sha256s": {
   "$comment": "sealed_dataset_sha256 of every prior attempt, in attempt order; the record's own sealed set is none of them",
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "prior_attempts_sha256": {
   "$comment": "sha256 of the canonical JSON of the manifest's prior_attempts list (sets, expectations and outcomes)",
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "dispatch_journal_head": {
   "$comment": "entry_sha256 of the last entry of the manifest's dispatch journal when the suite was verified; null only when the journal did not verify (the suite is then incomplete)",
   "oneOf": [
    {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    {
     "type": "null"
    }
   ]
  },
  "manifest_commit_ref": {
   "$comment": "the commit id or external timestamp reference under which the manifest sha256 was committed before the first dispatch, as recorded in the dispatch journal header; audited after the verdict",
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "ref"
     ],
     "properties": {
      "kind": {
       "enum": [
        "git_commit",
        "external_timestamp"
       ]
      },
      "ref": {
       "type": "string",
       "minLength": 1,
       "maxLength": 256
      }
     }
    }
   ]
  },
  "record_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 }
}
