{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "works-v1",
  "factory": "app.api.works:create_router",
  "routes": [
    {
      "route_id": "works.create",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/works",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "works.read",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/works/{work_id}",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "works.revise",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/works/{work_id}/revisions",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    }
  ]
}
