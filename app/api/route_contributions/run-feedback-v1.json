{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "run-feedback-v1",
  "factory": "app.api.run_feedback:create_router",
  "routes": [
    {"route_id": "runs.feedback", "methods": ["GET", "HEAD"],
     "path": "/api/v1/runs/{run_id}/feedback",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "runs.feedback_record", "methods": ["POST"],
     "path": "/api/v1/runs/{run_id}/feedback",
     "auth_policy": "browser_session", "required_scope": "work.command"}
  ]
}
