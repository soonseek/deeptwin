{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "credentials-v1",
  "factory": "app.api.credential_wiring:create_router",
  "routes": [
    {"route_id": "credentials.read", "methods": ["GET"], "path": "/api/v1/credentials",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "credentials.store", "methods": ["POST"], "path": "/api/v1/credentials",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "credentials.delete", "methods": ["DELETE"], "path": "/api/v1/credentials/{handle}",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "credentials.fence", "methods": ["POST"], "path": "/api/v1/credentials/fences",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "credentials.catalog_refresh", "methods": ["POST"],
     "path": "/api/v1/credentials/connections/{provider}/catalog-refresh",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "credentials.model_choice", "methods": ["POST"],
     "path": "/api/v1/credentials/connections/{provider}/model-choice",
     "auth_policy": "browser_session", "required_scope": "work.command"}
  ]
}
