{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "hypotheses-v1",
  "factory": "app.api.hypotheses:create_router",
  "routes": [
    {"route_id": "hypotheses.read", "methods": ["GET", "HEAD"],
     "path": "/api/v1/differences/{difference_id}/hypotheses",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "hypotheses.propose", "methods": ["POST"],
     "path": "/api/v1/differences/{difference_id}/hypotheses",
     "auth_policy": "browser_session", "required_scope": "work.command"}
  ]
}
