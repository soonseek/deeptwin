{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "run-approvals-v1",
  "factory": "app.api.run_approvals:create_router",
  "routes": [
    {"route_id":"runs.approvals.record","methods":["POST"],"path":"/api/v1/runs/{run_id}/approvals","auth_policy":"browser_session","required_scope":"approval.manage"},
    {"route_id":"runs.approvals.read","methods":["GET","HEAD"],"path":"/api/v1/runs/{run_id}/approvals/{node_id}/{approval_scope}","auth_policy":"browser_session","required_scope":"approval.read"},
    {"route_id":"runs.execution_approvals.record","methods":["POST"],"path":"/api/v1/runs/{run_id}/approvals/executions","auth_policy":"browser_session","required_scope":"approval.manage"},
    {"route_id":"runs.execution_approvals.read","methods":["GET","HEAD"],"path":"/api/v1/runs/{run_id}/approvals/executions","auth_policy":"browser_session","required_scope":"approval.read"}
  ]
}
