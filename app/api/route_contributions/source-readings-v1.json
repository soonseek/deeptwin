{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "source-readings-v1",
  "factory": "app.api.source_readings:create_router",
  "routes": [
    {"route_id": "source_readings.list", "methods": ["GET", "HEAD"], "path": "/api/v1/source-readings/{work_id}",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "source_readings.read", "methods": ["POST"], "path": "/api/v1/source-readings/{work_id}",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "source_readings.latest", "methods": ["GET", "HEAD"],
     "path": "/api/v1/source-readings/{work_id}/{source_id}",
     "auth_policy": "browser_session", "required_scope": "work.read"}
  ]
}
