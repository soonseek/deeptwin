{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "runs-v1",
  "factory": "app.api.runs:create_router",
  "routes": [
    {
      "route_id": "runs.create",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "runs.read",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.resume",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs/{run_id}/resume",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "runs.cancel",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs/{run_id}/cancel",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "runs.recover",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs/{run_id}/recover",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "runs.artifacts",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.artifact",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.artifact_content",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/content",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.artifact_preview",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/preview",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.artifact_drafts",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/drafts",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.artifact_draft_save",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/drafts",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "runs.artifact_draft",
      "methods": [
        "GET",
        "HEAD"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/drafts/{draft_id}",
      "auth_policy": "browser_session",
      "required_scope": "work.read"
    },
    {
      "route_id": "runs.artifact_draft_freeze",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/drafts/{draft_id}/freeze",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    },
    {
      "route_id": "runs.artifact_alternative_file",
      "methods": [
        "POST"
      ],
      "path": "/api/v1/runs/{run_id}/artifacts/{artifact_id}/alternative-files",
      "auth_policy": "browser_session",
      "required_scope": "work.command"
    }
  ]
}
