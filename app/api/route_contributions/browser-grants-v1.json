{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "browser-grants-v1",
  "factory": "app.api.browser_grants:create_router",
  "routes": [
    {"route_id": "browser_grants.read", "methods": ["GET", "HEAD"], "path": "/api/v1/browser-grants",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "browser_grants.create", "methods": ["POST"], "path": "/api/v1/browser-grants",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "browser_grants.revoke", "methods": ["POST"], "path": "/api/v1/browser-grants/{grant_id}/revoke",
     "auth_policy": "browser_session", "required_scope": "work.command"}
  ]
}
