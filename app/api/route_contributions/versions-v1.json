{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "versions-v1",
  "factory": "app.api.versions:create_router",
  "routes": [
    {"route_id": "versions.read", "methods": ["GET", "HEAD"], "path": "/api/v1/versions",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "versions.adopt", "methods": ["POST"], "path": "/api/v1/versions/adopt",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "versions.decide", "methods": ["POST"], "path": "/api/v1/versions/decisions",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "versions.activate", "methods": ["POST"], "path": "/api/v1/versions/activate",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "versions.rollback", "methods": ["POST"], "path": "/api/v1/versions/rollback",
     "auth_policy": "browser_session", "required_scope": "work.command"}
  ]
}
