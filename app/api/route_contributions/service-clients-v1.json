{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "service-clients-v1",
  "factory": "app.api.service_clients:create_router",
  "routes": [
    {"route_id":"service-clients.list","methods":["GET"],"path":"/api/v1/service-clients","auth_policy":"browser_session","required_scope":"service_client.read"},
    {"route_id":"service-clients.create","methods":["POST"],"path":"/api/v1/service-clients","auth_policy":"browser_session","required_scope":"service_client.manage"},
    {"route_id":"service-clients.read","methods":["GET"],"path":"/api/v1/service-clients/{client_id}","auth_policy":"browser_session","required_scope":"service_client.read"},
    {"route_id":"service-clients.rotate","methods":["POST"],"path":"/api/v1/service-clients/{client_id}/rotate","auth_policy":"browser_session","required_scope":"service_client.manage"},
    {"route_id":"service-clients.revoke","methods":["POST"],"path":"/api/v1/service-clients/{client_id}/revoke","auth_policy":"browser_session","required_scope":"service_client.manage"}
  ]
}
