{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "run-consents-v1",
  "factory": "app.api.run_consents:create_router",
  "routes": [
    {
      "route_id": "run_consents.record", "methods": ["POST"],
      "path": "/api/v1/run-consents",
      "auth_policy": "browser_session", "required_scope": "work.command"
    },
    {
      "route_id": "run_consents.read", "methods": ["GET", "HEAD"],
      "path": "/api/v1/run-consents/{consent_id}",
      "auth_policy": "browser_session", "required_scope": "work.read"
    }
  ]
}
