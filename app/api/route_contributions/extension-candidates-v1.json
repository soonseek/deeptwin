{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "extension-candidates-v1",
  "factory": "app.api.extension_candidates:create_router",
  "routes": [
    {"route_id":"extensions.candidates.create","methods":["POST"],"path":"/api/v1/extensions/candidates","auth_policy":"browser_session","required_scope":"extension.manage"},
    {"route_id":"extensions.candidates.list","methods":["GET"],"path":"/api/v1/extensions/candidates","auth_policy":"browser_session","required_scope":"extension.read"},
    {"route_id":"extensions.candidates.read","methods":["GET","HEAD"],"path":"/api/v1/extensions/candidates/{candidate_id}","auth_policy":"browser_session","required_scope":"extension.read"}
  ]
}
