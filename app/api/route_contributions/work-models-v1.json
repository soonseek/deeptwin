{
  "schema_version": "deeptwin-first-party-route-contribution-v1",
  "contribution_id": "work-models-v1",
  "factory": "app.api.work_models:create_router",
  "routes": [
    {"route_id": "work_models.draft", "methods": ["POST"], "path": "/api/v1/work-models",
     "auth_policy": "browser_session", "required_scope": "work.command"},
    {"route_id": "work_models.read", "methods": ["GET", "HEAD"], "path": "/api/v1/work-models/{work_model_id}",
     "auth_policy": "browser_session", "required_scope": "work.read"},
    {"route_id": "work_models.confirm", "methods": ["POST"], "path": "/api/v1/work-models/{work_model_id}/confirm",
     "auth_policy": "browser_session", "required_scope": "work.command"}
  ]
}
